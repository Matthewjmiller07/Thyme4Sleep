---
interface Props { kicker: string; title: string; sub?: string; logo?: string }
const { kicker, title, sub, logo = '/assets/img/logo.png' } = Astro.props;
---
<div class="sheet-head">
  <div>
    <span class="eyebrow">{kicker}</span>
    <h1 set:html={title} />
    {sub && <p class="muted" style="font-size:11pt;margin:0;">{sub}</p>}
  </div>
  <img src={logo} alt="Thyme4Sleep" />
</div>
