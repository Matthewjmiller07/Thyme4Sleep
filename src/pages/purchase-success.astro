---
// Stripe redirects here after a Reset to Rest purchase. We confirm the session with
// Stripe before granting access, then send the buyer to their guide and video.
import Layout from '../layouts/AssetsLayout.astro';
import { verifySession } from '../lib/calmNights';
import { RESET_PACKAGES, setResetCookie } from '../lib/resetToRest';
export const prerender = false;

const sessionId = Astro.url.searchParams.get('session_id');
if (!sessionId) return Astro.redirect('/reset-preview');

if (await verifySession(sessionId, RESET_PACKAGES)) {
  setResetCookie(Astro.cookies, sessionId);
  return Astro.redirect('/reset');
}
---
<Layout title="Confirming your purchase | Thyme4Sleep">
  <section class="band">
    <div class="narrow center">
      <span class="eyebrow">Almost there</span>
      <h1>We couldn’t confirm your payment just yet</h1>
      <hr class="divider" />
      <p class="muted">If you’ve just paid, Stripe can take a few seconds to finish. Please refresh this page. Still stuck? Email Georgia with your receipt and she’ll get you in straight away.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a class="btn btn-dark" href="">Refresh</a>
        <a class="btn btn-ghost" href="mailto:georgia@thyme4sleep.com?subject=Reset%20to%20Rest%20access">Email georgia@thyme4sleep.com</a>
      </div>
    </div>
  </section>
</Layout>
