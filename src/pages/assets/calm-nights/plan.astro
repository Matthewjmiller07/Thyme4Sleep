            <div class="decide">
              <div style="background:var(--mint-soft);"><strong>Keep going</strong>{c.onTrack}</div>
              <div style="background:var(--peach-soft);"><strong>Adjust</strong>{c.adjust}</div>
              <div style="background:var(--cream);"><strong>Get support</strong>{c.support}</div>
            </div>
          </div>
        ))}
      </section>

      <!-- Troubleshooting -->
