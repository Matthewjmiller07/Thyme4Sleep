---
import Layout from '../../layouts/AssetsLayout.astro';
export const prerender = true;

// Five stages placed around a circle
const stages = [
  { t: 'Attract', s: 'Social kit · Pinterest · Google profile', c: '#BCC8B9' },
  { t: 'Capture', s: 'Sleep Snapshot quiz · free printables', c: '#E3E9E1' },
  { t: 'Nurture', s: '5-day email sequence', c: '#F3EAE3' },
  { t: 'Convert', s: '$37 Reset · $97 Calm Nights · $117 bundle', c: '#F8E8D3' },
  { t: 'Delight', s: '1:1 coaching · reviews · $100 referrals', c: '#F1D4AE' },
];
const R = 190, CX = 300, CY = 260;
const pos = stages.map((_, i) => {
  const a = -Math.PI / 2 + (i * 2 * Math.PI) / stages.length;
  return { x: CX + R * Math.cos(a), y: CY + R * Math.sin(a) };
});

const checklist = [
  ['Before launch', [
    'Georgia reviews all copy for voice and clinical accuracy (wake windows, method steps, feed guidance)',
    'Set ASSETS_PREVIEW_KEY in Netlify, then review the paid plan at /assets/calm-nights/plan?preview=…',
    'Run one live $97 test purchase in Stripe, confirm access to the programme and workbook, then refund it',
    'Set up the Calm Nights tags and link-click rules for Sequences 3 and 4 (see the emails page), and click every check-in link once',
    'Connect quiz + Gentle Sleep Reset form leads to the email platform; load Sequences 1 and 2',
    'Decide whether to show Calm Nights on /pricing and the homepage (it’s unlinked today)',
  ]],
  ['Launch week', [
    'Swap the Instagram bio link to /assets/quiz',
    'Post carousel “Regression or habit?” + story 1 (quiz) on day 1',
    'Post quote card + story 3 (Calm Nights) mid-week; carousel “72-hour reset” at the weekend',
    'Email the existing list: “A clear path for families ready to do it themselves” → Calm Nights',
    'Pin both Pinterest pins to a “Baby Sleep Tips” board',
  ]],
  ['Every month', [
    'Check GA4 events: quiz_start → quiz_complete → generate_lead → begin_checkout → calm_nights_checkin',
    'Add each Calm Nights sale, refund, check-in answer and coaching enquiry to the review log below',
    'Ask every Calm Nights and 1:1 family for a one-line review (night 21 email of Sequence 3; email 4 of Sequence 2)',
    'Turn the best new review into a quote card',
    'Remove the noindex tag on pages you want found in Google once they’re linked from the site',
  ]],
];
// Measures for the Calm Nights $97 test review (see #review)
const reviewRows = [
  ['Will families pay $97?', 'Sales-page visitors → purchases', 'GA4 begin_checkout, Stripe', '2%+ of sales-page visitors buy', 'Under 1%'],
  ['Is the scope clear?', 'Refunds, and emails expecting a personalised plan', 'Stripe, Georgia’s inbox', 'Under 5% refunds; little or no confusion', 'Over 10%, or the same confusion repeating'],
  ['Does it work for families who fit?', 'Night 14 “things are moving” share', 'GA4 calm_nights_checkin', '60%+ of those who answer', 'Under 40%'],
  ['Does it route the right families to coaching?', 'cn-support tags → /pricing?from=calm-nights visits → enquiries → bookings', 'Email platform, GA4, Stripe', 'Families in the support branch enquire, and some book', 'Many tagged, no enquiries; or Starter bookings fall overall'],
  ['What does it cost Georgia?', 'Minutes spent replying per buyer', 'Review log', 'Under 10 minutes', 'Over 20 minutes (it’s becoming unpaid 1:1)'],
  ['Are we earning proof?', 'Reviews collected from Calm Nights families', 'Night 21 email replies', '1 in 5 successful families', 'None'],
];
---
<Layout title="The Flywheel & Launch Plan | Thyme4Sleep" description="How the Thyme4Sleep free and paid assets work together.">
  <section class="hero">
    <div class="wrap" style="grid-template-columns:1fr;max-width:860px;text-align:center;">
      <div>
        <span class="pill tool">Strategy</span>
        <h1 style="margin-top:18px;">The Thyme4Sleep Flywheel</h1>
        <hr class="divider" style="margin-inline:auto;" />
        <p class="lead" style="margin-inline:auto;">Free content earns attention. Attention becomes trust. Trust becomes a $37 or $97 purchase. Results become reviews and referrals — which make the next round of free content work harder. Every asset in the library has one job in that loop.</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap grid g2" style="align-items:center;gap:40px;">
      <svg viewBox="0 0 600 520" role="img" aria-label="Flywheel: Attract, Capture, Nurture, Convert, Delight, looping back to Attract" style="width:100%;max-width:560px;margin:auto;">
        <defs><marker id="ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#897E77" /></marker></defs>
        <circle cx={CX} cy={CY} r={R} fill="none" stroke="#E6DAD0" stroke-width="2" stroke-dasharray="4 8" />
        {pos.map((p, i) => {
          const q = pos[(i + 1) % pos.length];
          const mx = (p.x + q.x) / 2, my = (p.y + q.y) / 2;
          const k = 1.32; // push the curve outward
          const cx = CX + (mx - CX) * k, cy = CY + (my - CY) * k;
          return <path d={`M${p.x + (q.x - p.x) * .22} ${p.y + (q.y - p.y) * .22} Q${cx} ${cy} ${p.x + (q.x - p.x) * .78} ${p.y + (q.y - p.y) * .78}`} fill="none" stroke="#897E77" stroke-width="1.6" marker-end="url(#ah)" />;
        })}
        <circle cx={CX} cy={CY} r="74" fill="#3F3B38" />
        <text x={CX} y={CY - 6} text-anchor="middle" font-family="Cormorant Garamond, serif" font-size="26" fill="#F3EAE3">Calmer</text>
        <text x={CX} y={CY + 22} text-anchor="middle" font-family="Cormorant Garamond, serif" font-size="26" fill="#F1D4AE" font-style="italic">nights</text>
        {stages.map((s, i) => (
          <g>
            <circle cx={pos[i].x} cy={pos[i].y} r="52" fill={s.c} stroke="#fff" stroke-width="4" />
            <text x={pos[i].x} y={pos[i].y + 7} text-anchor="middle" font-family="Cormorant Garamond, serif" font-size="23" fill="#3F3B38">{s.t}</text>
          </g>
        ))}
      </svg>
      <div>
        {stages.map((s, i) => (
          <div style="display:flex;gap:16px;align-items:flex-start;margin-bottom:16px;">
            <span style={`flex:none;width:38px;height:38px;border-radius:50%;background:${s.c};display:grid;place-items:center;font-weight:600;`}>{i + 1}</span>
            <div><h3 style="font-size:1.4rem;margin:0;">{s.t}</h3><p class="small muted" style="margin:0;">{s.s}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band cream">
    <div class="wrap">
      <div class="center"><span class="eyebrow">The value ladder</span><h2>Every rung leads to the next</h2><hr class="divider" /></div>
      <div class="table-scroll card" style="padding:8px 20px;">
        <table>
          <thead><tr><th>Rung</th><th>Asset</th><th>Price</th><th>Job</th><th>Leads to</th></tr></thead>
          <tbody>
            <tr><td>1</td><td>Social kit, Pinterest pins</td><td>Free</td><td>Reach new parents</td><td>Quiz / free guide</td></tr>
            <tr><td>2</td><td>Sleep Snapshot quiz</td><td>Free</td><td>Diagnose &amp; segment; capture email</td><td>Tailored offer by result</td></tr>
            <tr><td>3</td><td>Gentle Sleep Reset, safe sleep, sleep log, bedtime chart</td><td>Free</td><td>Quick win, trust, list growth</td><td>5-day email sequence</td></tr>
            <tr><td>4</td><td>From Reset to Rest</td><td>$37</td><td>Reduce night wakings when bedtime is already calm</td><td>Calm Nights if bedtime is the real issue (email 3, Seq. 2)</td></tr>
            <tr><td>5</td><td>The Calm Nights Method (+ $117 bundle)</td><td>$97 (test price)</td><td>Structured self-guided programme for families ready to implement independently</td><td>1:1 via check-in emails when a family needs it (Seq. 3 → 4)</td></tr>
            <tr><td>6</td><td>1:1 coaching</td><td>$249–$1,429</td><td>Premium, personalised outcome</td><td>Reviews, $100 referrals → rung 1</td></tr>
          </tbody>
        </table>
      </div>
      <div class="grid g3" style="margin-top:24px;">
        <div class="card"><span class="eyebrow">Illustrative month</span><h3>500 new leads</h3><p class="small muted" style="margin:0;">from the quiz and free downloads</p></div>
        <div class="card"><span class="eyebrow">If 4% · 2% · 0.5% convert</span><h3>$740 + $970 + $1,372</h3><p class="small muted" style="margin:0;">Reset to Rest · Calm Nights · one Standard package for every 200 leads</p></div>
        <div class="card"><span class="eyebrow">≈ per month</span><h3>$3,080 in new revenue</h3><p class="small muted" style="margin:0;">Assumptions only — replace with your real GA4 and Stripe numbers after 30 days.</p></div>
      </div>
    </div>
  </section>

  <section class="band cream" id="review">
    <div class="narrow">
      <div class="center"><span class="eyebrow">The $97 test</span><h2>Review before investing further</h2><hr class="divider" /></div>
      <p>Calm Nights launches at <strong>$97 as a test price</strong>. Don’t add video, paid promotion, more content or a price change until the first meaningful batch of customers is in.</p>
      <div class="note"><p><strong>When to review:</strong> after the first <strong>25 Calm Nights purchases</strong>, or <strong>90 days</strong> after launch — whichever comes first. Fewer than 10 sales in 90 days is an answer in itself: go straight to “Rethink”.</p></div>
      <div class="table-scroll card" style="padding:8px 16px;">
        <table>
          <thead><tr><th>Question</th><th>Measure</th><th>Where</th><th>Healthy</th><th>Concern</th></tr></thead>
          <tbody>
            {reviewRows.map((r) => <tr>{r.map((c, i) => <td>{i === 0 ? <strong>{c}</strong> : c}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
      <h3 style="margin-top:32px;">Then decide</h3>
      <div class="grid g3">
        <div class="card" style="border-top:6px solid var(--mint);"><h4>Invest further</h4><p class="small muted" style="margin:0;">Most measures healthy. Options: short video walkthroughs of steps 4–5, a $117–127 price test, a homepage and /pricing listing, a small paid-social test.</p></div>
        <div class="card" style="border-top:6px solid var(--peach);"><h4>Hold &amp; refine</h4><p class="small muted" style="margin:0;">Mixed results. Fix the weakest measure only (sales copy, checkpoint wording, email timing), then review again after the next 25 sales.</p></div>
        <div class="card" style="border-top:6px solid var(--taupe);"><h4>Rethink</h4><p class="small muted" style="margin:0;">Low sales, frequent scope confusion or high time cost. Options: fold the best parts into Reset to Rest, offer it as a lower-priced guide, or keep it only as a lead-in for 1:1 clients.</p></div>
      </div>
      <h3 style="margin-top:32px;">Review log</h3>
      <p class="small muted">Keep this as a simple spreadsheet. One row per Calm Nights buyer.</p>
      <div class="table-scroll card" style="padding:8px 16px;">
        <table>
          <thead><tr><th>Date</th><th>Bought</th><th>Fit check</th><th>Night 4</th><th>Night 7</th><th>Night 14</th><th>Coaching enquiry?</th><th>Booked?</th><th>Refund?</th><th>Georgia’s minutes</th></tr></thead>
          <tbody><tr><td class="muted small">e.g. 2 Nov</td><td class="muted small">Calm Nights</td><td class="muted small">fit</td><td class="muted small">moving</td><td class="muted small">stuck</td><td class="muted small">support</td><td class="muted small">yes</td><td class="muted small">Starter</td><td class="muted small">no</td><td class="muted small">10</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="narrow">
      <div class="center"><span class="eyebrow">Launch checklist</span><h2>From unlinked to live</h2><hr class="divider" /></div>
      {checklist.map(([h, items]) => (
        <div class="card" style="margin-bottom:16px;">
          <h3>{h}</h3>
          <ul class="boxes" style="margin:0;">{(items as string[]).map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>
</Layout>
