---
import Layout from '../../layouts/AssetsLayout.astro';
import PrintBar from '../../components/assets/PrintBar.astro';
import SheetHead from '../../components/assets/SheetHead.astro';
import NextStep from '../../components/assets/NextStep.astro';
import Leaf from '../../components/assets/Leaf.astro';
import { AGE_BANDS, SAMPLE_DAYS } from '../../data/sleep';
export const prerender = true;
---
<Layout title="Wake Window & Nap Cheat Sheet | Thyme4Sleep" description="A free, printable wake window and nap guide from newborn to 5 years — with sample daily rhythms and sleepy cues.">
  <section class="hero no-print">
    <div class="wrap" style="grid-template-columns:1fr;max-width:860px;text-align:center;">
      <div>
        <span class="pill free">Free printable · 2 pages</span>
        <h1 style="margin-top:18px;">The Wake Window <em class="script">&amp;</em> Nap Cheat Sheet</h1>
        <hr class="divider" style="margin-inline:auto;" />
        <p class="lead" style="margin-inline:auto;">How long can my baby stay awake? How many naps? What time is bedtime? Everything on one fridge-ready page, newborn to five years — plus sample daily rhythms.</p>
      </div>
    </div>
  </section>

  <div class="sheet-stage">
    <PrintBar pdf="/assets/downloads/thyme4sleep-wake-window-cheat-sheet.pdf" />

    <article class="sheet">
      <SheetHead kicker="Thyme4Sleep · Cheat Sheet" title="Wake Windows <em class='script'>&amp;</em> Naps" sub="Typical ranges for healthy, full-term little ones. Use them as a starting point — your child’s cues come first." />
      <table>
        <thead><tr><th>Age</th><th>Wake window</th><th>Naps</th><th>Day sleep</th><th>Night sleep</th><th>Bedtime</th></tr></thead>
        <tbody>
          {AGE_BANDS.map((b) => (
            <tr>
              <td style="font-family:var(--serif);font-size:13pt;white-space:nowrap;">{b.age}</td>
              <td><strong>{b.wakeWindow}</strong></td>
              <td>{b.naps}</td>
              <td>{b.dayTotal}</td>
              <td>{b.night}</td>
              <td>{b.bedtime}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <h3 style="margin-top:18px;">Total sleep in 24 hours</h3>
      <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:6px;">
        {AGE_BANDS.map((b, i) => (
          <div style={`border-radius:12px;padding:10px 6px;text-align:center;background:${['#E3E9E1', '#F8E8D3', '#F3EAE3'][i % 3]};`}>
            <div style="font-size:7.5pt;letter-spacing:.08em;text-transform:uppercase;color:var(--mink);">{b.age}</div>
            <div style="font-family:var(--serif);font-size:15pt;line-height:1.1;margin-top:4px;">{b.totalSleep}</div>
          </div>
        ))}
      </div>
      <div class="grid" style="grid-template-columns:1fr 1fr;gap:14px;margin-top:18px;">
        <div class="note"><h3>Sleepy cues — start the routine</h3><p>Slowing down · staring off · rubbing eyes or ears · first yawn · quieter, “glassy” look · losing interest in toys.</p></div>
        <div class="note peach"><h3>Overtired cues — go earlier tomorrow</h3><p>Second wind &amp; zoomies · arching · fighting the feed · crying at lay-down · catnaps under 30 min · 5am wake-ups.</p></div>
      </div>
      <p class="small muted" style="margin-top:12px;"><strong>Rule of thumb:</strong> the shortest wake window is usually first thing in the morning; the longest is before bedtime. Adjust in 15-minute steps and hold each change for 3 days before judging it.</p>
      <Leaf size={150} class="leaf" style="right:-30px;bottom:30px;" />
      <div class="sheet-foot"><span>THYME4SLEEP.COM</span><span>General guidance only — not medical advice.</span></div>
    </article>

    <article class="sheet">
      <SheetHead kicker="Thyme4Sleep · Cheat Sheet" title="Sample Daily Rhythms" sub="Real-life shapes of a day. Times are illustrative — shift the whole day earlier or later to suit your family." />
      <div class="grid" style="grid-template-columns:1fr 1fr;gap:16px;">
        {SAMPLE_DAYS.map((d) => (
          <div class="card soft" style="padding:16px 18px;border-radius:16px;">
            <h3 style="font-size:13pt;">{d.age}</h3>
            <table>
              <tbody>
                {d.rows.map(([t, a]) => (<tr><td style="width:52px;padding:4px 6px;font-weight:600;color:var(--sage-deep);">{t}</td><td style="padding:4px 6px;">{a}</td></tr>))}
              </tbody>
            </table>
          </div>
        ))}
      </div>
      <div class="grid" style="grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px;">
        <div><h3 style="font-size:12pt;">Anchor the morning</h3><p>Same wake-up time (±30 min), every day — even after a rough night. Curtains open, daylight in.</p></div>
        <div><h3 style="font-size:12pt;">Feed early, not to sleep</h3><p>Offer the bedtime milk near the start of the routine, with lights on, so sleep isn’t tied to sucking.</p></div>
        <div><h3 style="font-size:12pt;">Down awake</h3><p>Calm and drowsy is fine — but let the last step into sleep be theirs. That’s the skill that connects night cycles.</p></div>
      </div>
      <div class="sheet-foot"><span>THYME4SLEEP.COM · Free sleep resources</span><span>© Thyme4Sleep LLC</span></div>
    </article>
  </div>

  <NextStep variant="quiz" />
</Layout>
